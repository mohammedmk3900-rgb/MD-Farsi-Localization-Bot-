PARATRANZ_PROJECT_ID=19621
# ParaTranz API token. Sent as the raw Authorization header value; never commit it.
PARATRANZ_TOKEN=
PARATRANZ_BASE_URL=https://paratranz.cn/api
PARATRANZ_TIMEOUT_SECONDS=20
PARATRANZ_MAX_RETRIES=3
PARATRANZ_PAGE_SIZE=100
PARATRANZ_MAX_PAGES=100

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Stable Discord channel IDs; no webhook URLs.
CHANNEL_STATS=
CHANNEL_PROGRESS=
CHANNEL_ACHIEVEMENTS=
CHANNEL_HEALTH=
CHANNEL_REPORTS=
CHANNEL_GLOSSARY=

DATABASE_PATH=data/platform.db

# Required to authorize management endpoints.
API_TOKEN=

# Optional CORS origins, comma-separated.
CORS_ORIGINS=

# Autonomous scheduler.
SCHEDULER_POLL_SECONDS=30
SCHEDULER_LEASE_SECONDS=900

# Local/shared Discord MCP index used by the autonomous intelligence producer
DISCORD_DATABASE_PATH=../discord-mcp/data/discord.db
