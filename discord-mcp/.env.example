DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Authentication mode:
# - static: legacy/local bearer token
# - oauth: ChatGPT/MCP OAuth 2.1 with an OIDC provider such as Auth0
MCP_AUTH_MODE=oauth

# Canonical HTTPS resource identifier used by MCP OAuth metadata.
MCP_RESOURCE_URL=https://dawnnexus.onrender.com

# OAuth authorization server (Auth0 example).
# Example: https://your-tenant.eu.auth0.com
MCP_AUTH_ISSUER=
# Auth0 API Identifier / audience for the DawnNexus resource server.
MCP_AUTH_AUDIENCE=
# Optional explicit JWKS endpoint; defaults to <issuer>/.well-known/jwks.json
MCP_AUTH_JWKS_URL=
# Space-separated scopes advertised to ChatGPT.
MCP_AUTH_SCOPES=discord:read

# Legacy static mode only. Do not use this as the ChatGPT OAuth credential.
MCP_AUTH_TOKEN=

# Host/origin allowlists for MCP transport security.
MCP_ALLOWED_HOSTS=dawnnexus.onrender.com,dawnnexus.onrender.com:*
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com

# DawnNexus self-hosted OAuth authorization server.
MCP_PUBLIC_URL=https://dawnnexus.onrender.com
MCP_OAUTH_USERNAME=admin
MCP_OAUTH_PASSWORD=
