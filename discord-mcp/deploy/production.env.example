# Public hostname that resolves to this machine.
MCP_DOMAIN=mcp.example.com

DISCORD_BOT_TOKEN=replace-me
DISCORD_GUILD_ID=replace-me

MCP_HOST=0.0.0.0
MCP_PORT=8000

MCP_AUTH_REQUIRED=true
# Generate a random value of at least 32 characters.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Set only when you know the exact Origin(s) your MCP client sends.
# Example:
# MCP_ALLOWED_ORIGINS=https://chatgpt.com
MCP_ALLOWED_ORIGINS=

DISCORD_BACKFILL_ON_START=false
DISCORD_BACKFILL_CONCURRENCY=2
LOG_LEVEL=INFO
