DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MCP_HOST=0.0.0.0
MCP_PORT=8000

# DawnNexus currently uses its built-in OAuth 2.1 authorization server.
# It is a single-owner, read-only authorization flow (scope: discord:read).
MCP_PUBLIC_URL=https://dawnnexus.onrender.com
MCP_OAUTH_USERNAME=admin
# Required in production; use a unique secret of at least 16 characters.
MCP_OAUTH_PASSWORD=

# Host/origin allowlists for MCP transport security.
MCP_ALLOWED_HOSTS=dawnnexus.onrender.com,dawnnexus.onrender.com:*
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com
