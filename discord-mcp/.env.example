DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# MCP HTTP listener
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Production security: keep enabled and use a random 32+ character secret.
MCP_AUTH_REQUIRED=true
MCP_AUTH_TOKEN=

# Optional comma-separated Origin allowlist.
# Leave empty when the client does not send Origin.
MCP_ALLOWED_ORIGINS=

# Startup backfill can be expensive on large servers.
DISCORD_BACKFILL_ON_START=false
DISCORD_BACKFILL_CONCURRENCY=2

LOG_LEVEL=INFO
