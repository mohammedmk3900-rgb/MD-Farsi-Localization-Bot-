DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Required: shared bearer token for the public MCP endpoint.
# Generate a long random secret and set the same value in Render.
